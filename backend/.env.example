PORT=3000
# Origens permitidas (separadas por vírgula). 5500 é a porta padrão do Live Server do VS Code.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# Banco de dados (mesmos valores do docker-compose.yml na raiz do repositório).
# Se ficar vazio, o servidor usa armazenamento em memória.
DATABASE_URL=postgresql://atendimento:atendimento@localhost:5432/atendimento

# Serviço de IA. Por enquanto só existe o provedor simulado ("mock").
IA_PROVIDER=mock
# Quanto tempo (em ms) esperar a resposta da IA antes de desistir.
IA_TIMEOUT_MS=8000
# Comportamento do provedor simulado: normal, json_quebrado, campo_faltando, categoria_inventada,
# prioridade_invalida, resposta_vazia, markdown, texto_extra, timeout, indisponivel ou instavel.
IA_MOCK_MODO=normal
# Tempo (em ms) que a IA simulada demora para responder.
IA_MOCK_LATENCIA_MS=300