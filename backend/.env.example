PORT=3000
# Origens permitidas (separadas por vírgula). 5500 é a porta padrão do Live Server do VS Code.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
# Banco de dados (mesmos valores do docker-compose.yml na raiz do repositório).
# Se ficar vazio, o servidor usa armazenamento em memória.
DATABASE_URL=postgresql://atendimento:atendimento@localhost:5432/atendimento
